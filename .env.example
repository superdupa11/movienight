# Plex — LAN IP, not plex.tv. See docs/README "Getting your Plex token".
PLEX_URL=http://192.168.1.10:32400
PLEX_TOKEN=
# Blank = auto-detect all movie-type sections.
PLEX_LIBRARY_SECTIONS=

# App
PORT=8080
PUBLIC_URL=http://localhost:8080
DB_PATH=./data/movienight.db
ART_CACHE_DIR=./data/art
INGEST_CRON=0 4 * * *
SESSION_SECRET=change-me-to-a-long-random-string
TZ=America/Chicago
